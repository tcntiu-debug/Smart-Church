{
    "name": "TCN Ikorodu - Smart Church",
    "short_name": "Smart Church",
    "description": "TCN Ikorodu member portal: first timers, follow-up, birthdays, announcements and the weekly call list.",
    "id": "/home",
    "start_url": "/home",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait-primary",
    "background_color": "#ffffff",
    "theme_color": "#F97316",
    "icons": [
        {
            "src": "/icons/icon-192-v2.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-512-v2.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/maskable-512-v2.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Dashboard",
            "url": "/home",
            "icons": [{ "src": "/icons/icon-192-v2.png", "sizes": "192x192", "type": "image/png" }]
        },
        {
            "name": "Week List",
            "url": "/weeklist",
            "icons": [{ "src": "/icons/icon-192-v2.png", "sizes": "192x192", "type": "image/png" }]
        },
        {
            "name": "Notifications",
            "url": "/notifications",
            "icons": [{ "src": "/icons/icon-192-v2.png", "sizes": "192x192", "type": "image/png" }]
        }
    ]
}
