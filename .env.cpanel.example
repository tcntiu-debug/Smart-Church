# =====================================================================
# Smart-Church - cPanel / production environment template
# ---------------------------------------------------------------------
# DO NOT COMMIT a filled-in copy of this file.
#
# One-time setup on the server:
#   cPanel > File Manager > open the deploy folder -- for a subdomain that is
#   /home/tcnikoro/smart-church, whose public/ subfolder is the document root
#   > create a new file named  .env  > paste an adapted copy of this
#   > then run:  php artisan key:generate
#
# The deployment pipeline never uploads .env, so whatever you create here
# survives every future deploy.
# =====================================================================

APP_NAME="Smart-Church"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Must match the subdomain exactly (scheme + host, no trailing slash), or generated
# links, uploaded-file URLs and redirects will point at the wrong host.
APP_URL=https://church.your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel prefixes every database and user with the account name
# (e.g. account "tcnikoro" -> database "tcnikoro_smart_church").
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tcnikoro_smart_church
DB_USERNAME=tcnikoro_smart_church
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.your-domain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Telegram bot notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Welcome Center birthday reminders - all optional, the defaults below are built in.
# See docs/CPANEL-DEPLOYMENT.md -> "Scheduled jobs".
# BIRTHDAY_DAYS=3,2,1                 # milestones (days before the birthday) to remind on
# BIRTHDAY_SEND_AT=07:00              # local time of the daily run
# BIRTHDAY_TIMEZONE=Africa/Lagos
# BIRTHDAY_DEPARTMENT_IDS=28          # 28 = Welcome Center
# BIRTHDAY_CHANNELS=mail,database,telegram
# BIRTHDAY_EXTRA_EMAILS=
# BIRTHDAY_TELEGRAM_CHAT_IDS=         # falls back to TELEGRAM_CHAT_ID
# BIRTHDAY_WISH_COUNTRY_CODE=234

# Shared hosting usually caps this lower than a local machine.
PHP_MEMORY_LIMIT=512M
