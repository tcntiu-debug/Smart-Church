# =====================================================================
# Smart-Church - cPanel / production environment template
# ---------------------------------------------------------------------
# DO NOT COMMIT a filled-in copy of this file.
#
# One-time setup on the server:
#   cPanel > File Manager > the deploy folder -- on this account every domain is a
#   folder inside public_html/, so smartchurch.tcnikorodu.org lives in
#   /home/tcnikoro/public_html/smartchurch.tcnikorodu.org/
#   > create a new file named  .env  > paste an adapted copy of this
#   > then run:  php artisan key:generate      <-- only if the account has a
#     Terminal. This cPanel account has shell access disabled, so either paste the
#     existing APP_KEY from the old install (see the note below) or generate one
#     where you do have a shell and paste the result:
#       php artisan key:generate --show
#
# The deployment pipeline never uploads .env, so whatever you create here
# survives every future deploy.
#
# Moving an existing install onto a new subdomain: APP_KEY and API_TOKEN_KEY
# must be copied from the old server byte for byte, or every signed-in browser
# and every installed phone is logged out (docs/MIGRATION-smartchurch.md).
# This file is a SUPERSET of what the app needs: the blocks marked UNUSED are
# inert and can be deleted. The required minimum is the 16 keys listed in
# docs/MIGRATION-smartchurch.md section 2 step 7.
# =====================================================================

APP_NAME="Smart Church"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Must match the subdomain exactly (scheme + host, no trailing slash), or generated
# links, uploaded-file URLs and redirects will point at the wrong host.
APP_URL=https://smartchurch.tcnikorodu.org

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel prefixes every database and user with the account name
# (e.g. account "tcnikoro" -> database "tcnikoro_smartchurch"). The database the
# new install is cut over to is separate from the old one on purpose, so the old
# one can stay untouched as the rollback path.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tcnikoro_smartchurch
DB_USERNAME=tcnikoro_smartchurch
DB_PASSWORD=

BROADCAST_DRIVER=log
# Keep these three exactly as they are. There is no queue worker on the account,
# and the database has neither a `sessions` nor a `cache` table - no migration
# creates them - so `database` for either driver is an immediate 500
# ("Base table or view not found: ... sessions").
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---- UNUSED: leave untouched or delete --------------------------------------
# No code path opens a Redis or memcached connection. CACHE_DRIVER=file above is
# the only cache store in play, so these values are never read.
MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.your-domain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- UNUSED: leave every value empty, or delete the whole block --------------
# Nothing reads AWS_* or PUSHER_*. Uploaded photos are written to public/ by
# absolute path (no Storage::* / ->disk() call exists anywhere in app/),
# FILESYSTEM_DRIVER=local above is the only disk in play, and BROADCAST_DRIVER=log
# replaces Pusher. Filling these in changes nothing.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Telegram bot notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Welcome Center birthday reminders - all optional, the defaults below are built in.
# See docs/CPANEL-DEPLOYMENT.md -> "Scheduled jobs".
# BIRTHDAY_DAYS=3,2,1                 # milestones (days before the birthday) to remind on
# BIRTHDAY_SEND_AT=07:00              # local time of the daily run
# BIRTHDAY_TIMEZONE=Africa/Lagos
# BIRTHDAY_DEPARTMENT_IDS=28          # 28 = Welcome Center
# BIRTHDAY_CHANNELS=mail,database,telegram
# BIRTHDAY_EXTRA_EMAILS=
# BIRTHDAY_TELEGRAM_CHAT_IDS=         # falls back to TELEGRAM_CHAT_ID
# BIRTHDAY_WISH_COUNTRY_CODE=234

# Shared hosting usually caps this lower than a local machine.
PHP_MEMORY_LIMIT=512M

# ---- API access tokens (the mobile app and every /api/* client) ----------------
# POST /api/login returns a signed HS256 JWT and that token is the credential for
# every protected route, so this value is a production secret: never commit it,
# never paste it into a front-end, a chat or a ticket.
#
# Generate it ONCE on the server and keep it:
#   php -r "echo base64_encode(random_bytes(48)).PHP_EOL;"
# Then set API_TOKEN_KEY to the printed value. Without it the app falls back to
# APP_KEY, which works but couples the two: rotating APP_KEY would sign every
# mobile user out at once.
#
# CHANGING API_TOKEN_KEY INVALIDATES EVERY OUTSTANDING TOKEN (that is the
# emergency "log everyone out" switch - see docs/API-TOKENS.md). During the move
# to a new subdomain it must be copied from the old server unchanged, or every
# installed mobile app has to be signed in again.
# API_TOKEN_KEY=
# API_TOKEN_TTL_DAYS=90              # days before the holder must sign in again
# API_TOKEN_ISSUER=                  # defaults to APP_URL; recorded as `iss`
