# =====================================================================
# Smart-Church - cPanel / production environment template
# ---------------------------------------------------------------------
# DO NOT COMMIT a filled-in copy of this file.
#
# One-time setup on the server:
#   cPanel > File Manager > open the project root (e.g. public_html)
#   > create a new file named  .env  > paste an adapted copy of this
#   > then run:  php artisan key:generate
#
# The deployment pipeline never uploads .env, so whatever you create here
# survives every future deploy.
# =====================================================================

APP_NAME="Smart-Church"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel prefixes every database and user with the account name
# (e.g. account "tcnikoro" -> database "tcnikoro_smart_church").
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tcnikoro_smart_church
DB_USERNAME=tcnikoro_smart_church
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.your-domain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Telegram bot notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared hosting usually caps this lower than a local machine.
PHP_MEMORY_LIMIT=512M
