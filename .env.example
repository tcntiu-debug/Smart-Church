APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Welcome Center birthday reminders (all optional - the defaults shown are built in).
# Drives the scheduled e-mail + Telegram push + in-app bell digest.
BIRTHDAY_DAYS=3,2,1
BIRTHDAY_SEND_AT=07:00
BIRTHDAY_TIMEZONE=Africa/Lagos
BIRTHDAY_DEPARTMENT_IDS=28
BIRTHDAY_CHANNELS=mail,database,telegram
BIRTHDAY_EXTRA_EMAILS=
BIRTHDAY_TELEGRAM_CHAT_IDS=
BIRTHDAY_WISH_COUNTRY_CODE=234
#
# Optional dedicated mailbox for the digest. It is NOT needed for password
# reset: leave BIRTHDAY_MAIL_MAILER empty and the digest keeps using MAIL_*.
# Set BIRTHDAY_MAIL_MAILER=birthday to send from the BIRTHDAY_MAIL_* account
# instead (every value falls back to the matching MAIL_* setting).
# BIRTHDAY_MAIL_MAILER=birthday
# BIRTHDAY_MAIL_HOST=mail.lit-grp.com
# BIRTHDAY_MAIL_PORT=587
# BIRTHDAY_MAIL_USERNAME=welcome@lit-grp.com
# BIRTHDAY_MAIL_PASSWORD=
# BIRTHDAY_MAIL_ENCRYPTION=tls
# BIRTHDAY_MAIL_FROM_ADDRESS=welcome@lit-grp.com
# BIRTHDAY_MAIL_FROM_NAME="Welcome Center"

# ---- Single campus mode (config/campus.php) -----------------------------------
# TCN Ikorodu is one church, so the campus layer in the app is retired: every
# call site still reads as a campus filter (->forCurrentCampus()), but no query
# is narrowed by campus_id any more, new rows are left without one, and the
# campus_id that was already on the rows has been retired (2026_10_14_000002 /
# _000003). Set SINGLE_CAMPUS=false to bring every campus filter back
# (a Super User then sees all campuses, everyone else only their own) - the ids
# have to be restored first (php artisan migrate:rollback --step=1); see
# docs/SINGLE-CAMPUS.md.
SINGLE_CAMPUS=true
DEFAULT_CAMPUS_ID=1
DEFAULT_CAMPUS_NAME=Ikorodu

# ---- API access tokens (the mobile app and every /api/* client) ----------------
# POST /api/login returns a signed HS256 JWT; that token is the credential for
# every protected route, so API_TOKEN_KEY is a production secret and must never
# be shared with a client or committed.
#
# It defaults to APP_KEY, which works but couples the two: rotating APP_KEY would
# sign every mobile user out at once. Set API_TOKEN_KEY to its own long random
# value in production:
#   php -r "echo base64_encode(random_bytes(48)).PHP_EOL;"
#
# API_TOKEN_TTL_DAYS is how long a token stays valid before the holder must sign
# in again (there is no refresh endpoint yet).
# API_TOKEN_KEY=
# API_TOKEN_TTL_DAYS=90
# API_TOKEN_ISSUER=            # defaults to APP_URL; recorded as the `iss` claim
